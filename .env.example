# ==============================================================================
# TruthLens Environment Configuration Template
# Copy this file to .env and adjust variables as required for your environment.
# DO NOT commit .env with real credentials into version control.
# ==============================================================================

# Application Environment (development | staging | production | testing)
PYTHONPATH=.
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="TruthLens"
API_V1_STR="/api/v1"
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration
# Primary: PostgreSQL with pgvector (used in Docker / Production)
# e.g.: postgresql+asyncpg://truthlens_user:truthlens_password@localhost:5432/truthlens
DATABASE_URL=postgresql+asyncpg://truthlens_user:truthlens_password@localhost:5432/truthlens

# Fallback Database (used automatically when PostgreSQL is unavailable or in local test mode)
DATABASE_FALLBACK_SQLITE_URL=sqlite+aiosqlite:///./truthlens.db

# Cache / Redis (Optional, fallback to in-memory/fakeredis if offline)
REDIS_URL=redis://localhost:6379/0

# Machine Learning & Embeddings
MODEL_DEVICE=cpu
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
NLI_MODEL_NAME=roberta-large-mnli
DEFAULT_RANDOM_SEED=42

# Evidence Retrieval API Keys (Optional - live web retrieval)
# DUCKDUCKGO_SEARCH_ENABLED=true
# BING_SEARCH_API_KEY=

# LLM Explanation Provider (Optional - Gemini / Anthropic / OpenAI / Ollama)
LLM_PROVIDER=offline
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Security Limits
MAX_ARTICLE_CHARS=50000
MAX_CLAIMS_PER_ARTICLE=10
REQUEST_TIMEOUT_SECONDS=30
